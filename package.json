{
  "name": "devos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @devos/dashboard dev",
    "build": "pnpm --filter @devos/dashboard build",
    "start": "pnpm --filter @devos/dashboard start",
    "lint": "pnpm --filter @devos/dashboard lint",
    "typecheck": "pnpm --filter @devos/dashboard typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  }
}

