# DEVOS API Server Environment Variables

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=file:./dev.db

# Frontend Application URL (for CORS and OAuth redirect destinations)
FRONTEND_URL=http://localhost:3000

# Session Security (32+ random characters for signing and cookie encryption)
SESSION_SECRET=devos-production-session-secret-change-in-production-min32chars

# Instant Demo Access Mode (Set to true to allow hackathon judges demo access without GitHub login)
DEVOS_DEMO_MODE=true

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

