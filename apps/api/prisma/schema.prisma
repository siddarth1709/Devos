generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Repository {
  id            String     @id @default(cuid())
  name          String
  path          String     @unique
  defaultBranch String     @default("main")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  analyses      Analysis[]
  symbols       Symbol[]
}

model Analysis {
  id               String            @id @default(cuid())
  repositoryId     String
  repository       Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  baseSha          String
  headSha          String
  status           String            @default("queued")
  startedAt        DateTime?
  finishedAt       DateTime?
  error            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  changedFiles     ChangedFile[]
  evidences        Evidence[]
  findings         Finding[]
  hypotheses       Hypothesis[]
  recommendations  Recommendation[]
  investigations   Investigation[]
  rejectedClaims   RejectedClaim[]
  dependencyNodes  DependencyNode[]
  dependencyEdges  DependencyEdge[]
  actionExecutions ActionExecution[]
  symbols          Symbol[]
}

model ChangedFile {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  path       String
  changeType String
  oldPath    String?
  baseSha    String
  headSha    String
  collector  String
  createdAt  DateTime @default(now())
}

model Symbol {
  id              String      @id @default(cuid())
  repositoryId    String
  repository      Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisId      String?
  analysis        Analysis?   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  symbolKey       String
  name            String
  kind            String
  file            String
  lineStart       Int
  lineEnd         Int
  colStart        Int?
  colEnd          Int?
  isExported      Boolean     @default(false)
  containerName   String?
  signature       String?
  importKind      String?
  importedName    String?
  localName       String?
  moduleSpecifier String?
  exportKind      String?
  exportAlias     String?
  isReExport      Boolean     @default(false)
  reExportModule  String?
  metadata        String?
  commitSha       String
  collector       String
  createdAt       DateTime    @default(now())

  @@index([symbolKey])
  @@index([analysisId])
  @@index([repositoryId])
}

model DependencyEdge {
  id               String    @id @default(cuid())
  analysisId       String?
  analysis         Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  repositoryId     String?
  edgeKey          String    @default("")
  from             String
  to               String
  kind             String
  sourceFile       String
  sourceLine       Int
  sourceCol        Int?
  resolutionStatus String    @default("resolved")
  commitSha        String
  collector        String
  metadata         String?
  createdAt        DateTime  @default(now())

  @@index([analysisId])
  @@index([edgeKey])
  @@index([from])
  @@index([to])
}

model DependencyNode {
  id           String    @id @default(cuid())
  analysisId   String
  analysis     Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  nodeKey      String
  nodeType     String
  name         String
  path         String?
  symbolKey    String?
  repositoryId String
  commitSha    String
  collector    String
  metadata     String?
  createdAt    DateTime  @default(now())

  @@unique([analysisId, nodeKey])
  @@index([nodeKey])
  @@index([analysisId])
}

model Evidence {
  id           String            @id @default(cuid())
  analysisId   String?
  analysis     Analysis?         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  type         String
  sourceCommit String
  file         String
  lineStart    Int?
  lineEnd      Int?
  symbol       String?
  collector    String
  collectedAt  DateTime          @default(now())
  payload      String
  findings     FindingEvidence[]
}

model Finding {
  id             String            @id @default(cuid())
  analysisId     String
  analysis       Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  title          String
  severity       String
  description    String
  origin         String
  status         String
  confidence     String
  baseSha        String
  headSha        String
  collector      String
  createdAt      DateTime          @default(now())
  evidences      FindingEvidence[]
  rejectedClaims RejectedClaim[]
}

model FindingEvidence {
  findingId  String
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([findingId, evidenceId])
}

model Hypothesis {
  id          String   @id @default(cuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  title       String
  description String
  rationale   String
  status      String
  confidence  String
  baseSha     String
  headSha     String
  collector   String
  createdAt   DateTime @default(now())
}

model Recommendation {
  id              String   @id @default(cuid())
  analysisId      String
  analysis        Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  title           String
  description     String
  priority        String
  suggestedAction String?
  rationale       String?
  baseSha         String
  headSha         String
  collector       String
  createdAt       DateTime @default(now())
}

model ActionExecution {
  id          String    @id @default(cuid())
  analysisId  String?
  analysis    Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  actionName  String
  params      String
  status      String
  approvedBy  String?
  approvedAt  DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  output      String?
  error       String?
  commitSha   String
  collector   String
  createdAt   DateTime  @default(now())
}

model Investigation {
  id         String    @id @default(cuid())
  analysisId String
  analysis   Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  status     String
  stage      String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  baseSha    String
  headSha    String
  collector  String
}

model RejectedClaim {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  findingRef String?
  finding    Finding? @relation(fields: [findingRef], references: [id], onDelete: SetNull)
  reason     String
  claimText  String
  baseSha    String
  headSha    String
  collector  String
  createdAt  DateTime @default(now())
}
